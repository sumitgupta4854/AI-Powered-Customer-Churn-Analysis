# ─────────────────────────────────────────────────────────────
#  AI-Powered Customer Churn Analysis — Environment Variables
# ─────────────────────────────────────────────────────────────

# Optional: OpenAI API Key for AI-powered natural language insights.
# If not provided, the application falls back to rule-based insights.
# Get your key at: https://platform.openai.com/api-keys
AI_API_KEY=your_openai_api_key_here

# Optional: Specify the OpenAI model to use (default: gpt-3.5-turbo)
AI_MODEL=gpt-3.5-turbo

# Optional: Override the base URL if using a compatible API (e.g. Azure OpenAI)
# AI_BASE_URL=https://your-azure-endpoint.openai.azure.com/
